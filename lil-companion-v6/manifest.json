{
  "manifest_version": 3,
  "name": "Lil Companion \u2014 Pixel Pet",
  "version": "6.0.0",
  "description": "A tiny pixel cat that reacts while you browse, type and listen to music.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Lil Companion",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "pet.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "cat-orange.png",
        "sad.png",
        "angry.png",
        "happy.png",
        "love.png",
        "dizzy.png",
        "typing.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}